{
  "name": "roumi-server",
  "version": "1.0.0",
  "description": "RouMi Backend - Express + Socket.IO hosting the dispatch engine for Render deployment",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
